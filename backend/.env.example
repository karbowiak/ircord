# Optional local overrides for make backend. Copy to backend/.env to customize.
# Air's dedicated Go build-cache budget in MiB (pruned between builds).
IRCORD_GO_CACHE_MAX_MB=2048
# This file is sourced as shell assignments from the repository root.
# The Makefile supplies these defaults when the variables are unset:
# IRCORD_DATA_DIR=.data/live
# IRCORD_LISTEN=127.0.0.1:8080
# IRCORD_PUBLIC_URL=http://127.0.0.1:3000
# IRCORD_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Existing .data/live/registration-key and .data/live/network-passwords.json
# are detected automatically. Keep credentials in ignored files and reference
# their paths here; never put credentials in tracked configuration.
# IRCORD_REGISTRATION_KEY_FILE=/private/path/registration-key
# IRCORD_NETWORK_PASSWORDS_FILE=/private/path/network-passwords.json

# Public file, Reddit, and generic oEmbed resolution for visible message links.
# Instagram, TikTok, yt-dlp, and Iframely remain inactive.
# IRCORD_LINKMEDIA_TIMEOUT=75s
# IRCORD_LINKMEDIA_MAX_FILE_BYTES=52428800
# Optional backend-only Reddit OAuth credentials. Set both client values.
# Reddit images and ordered galleries require the validated CDN configuration.
# Galleries allow at most 30 assets and 100 MiB total, within the same timeout.
# Reddit videos with separate audio fall back to generic oEmbed or a link card.
# IRCORD_REDDIT_CLIENT_ID=
# IRCORD_REDDIT_CLIENT_SECRET=
# IRCORD_REDDIT_USER_AGENT='IRCord/1.0 (link media)'

# Configure the complete CDN set for validated 90-day file and preview copies.
# Without usable CDN storage, external files show information/original-link cards.
# After storage opens, the backend starts bounded expiry cleanup every minute.
# Originals and source expiry remain private metadata; public keys are random.
# Public URLs use PUBLIC_URL/PREFIX/object-key; credentials are backend-only.
# IRCORD_CDN_ENDPOINT=http://127.0.0.1:19000
# IRCORD_CDN_BUCKET=ircord-media
# IRCORD_CDN_REGION=us-east-1
# IRCORD_CDN_PREFIX=media
# IRCORD_CDN_PUBLIC_URL=https://cdn.ircord.com
# IRCORD_CDN_ACCESS_KEY=
# IRCORD_CDN_SECRET_KEY=
# IRCORD_CDN_SESSION_TOKEN=
# The backend never reads or writes bucket lifecycle configuration at startup.
# Operators must merge a 90-day expiration rule for PREFIX/link-media/ into the
# existing bucket rules as a backstop while the backend is stopped. Preserve all
# other rules. With the default PREFIX, the full key prefix is media/link-media/.
# Rule fragment for storage deployment tools (merge into the current Rules list):
# {"ID":"ircord-public-media-90d","Status":"Enabled","Filter":{"Prefix":"media/link-media/"},"Expiration":{"Days":90}}
# Versioned buckets also need noncurrent-version expiration for this prefix.
# Require only object GetObject, PutObject and DeleteObject permissions for the
# backend. Keep lifecycle administration in the storage owner's deployment tools.
# Delivery caches must respect origin revalidation and avoid stale-on-error use.
# Drain the old prefix before changing the endpoint, bucket, prefix or public URL;
# the backend cleans only the currently configured storage namespace.

# Server owners: comma-separated IRCord usernames that can open Administration. A name only
# resolves to an account that already existed when it was first configured (see README).
IRCORD_OWNERS=
