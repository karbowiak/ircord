# Klipy's standard integration uses direct browser requests. This app key is browser-visible.
NUXT_PUBLIC_KLIPY_API_KEY=

# Live mode (default): same-origin API/WebSocket/file forwarding to Go.
NUXT_BACKEND_URL=http://127.0.0.1:8080
NUXT_DEMO=false
# Set NUXT_DEMO=true to run the isolated Nitro fixtures instead.

# Optional public presets for Add Network (JSON array; replaces built-in presets).
# Only connection hints: never put server passwords in NUXT_PUBLIC_* variables.
NUXT_PUBLIC_NETWORK_PRESETS='[{"name":"IRCord","host":"irc.ircord.com","port":6697,"tls":true,"authMethod":"server-password","autoJoin":["#general"]}]'
# Open first-connection setup for live accounts with no networks. The first preset is preselected.
NUXT_PUBLIC_FIRST_CONNECTION_GUIDE=true
